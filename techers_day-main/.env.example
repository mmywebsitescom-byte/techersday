# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# Option 1: Direct Firebase Firestore live database connection (Service Account JSON)
# Paste the JSON string of your Firebase Service Account Key (from Firebase Console -> Project Settings -> Service Accounts):
# FIREBASE_SERVICE_ACCOUNT='{"type": "service_account", "project_id": "techxeraday", ...}'

# Option 2: Proxy to Live Deployed Backend (e.g. Vercel or Cloud Run URL)
# If your app is deployed live, provide its URL to fetch all live data automatically:
# LIVE_BACKEND_URL="https://your-deployed-app.vercel.app"

