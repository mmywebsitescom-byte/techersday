rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ── Helper: All writes come from Firebase Admin SDK (server-side) ─
    // Since this project uses server-side Admin SDK for all writes,
    // we allow all backend requests (Admin SDK bypasses these rules).
    // These rules protect direct client-side Firestore access.

    // ── Teachers Collection ─────────────────────────────────────────
    // Anyone can read teacher profiles (public website)
    // Writes are handled server-side via Admin SDK (bypasses rules)
    match /teachers/{teacherId} {
      allow read: if true;
      allow write: if false;
    }

    // ── Departments Collection ──────────────────────────────────────
    // Anyone can read department info (public website)
    // Writes are handled server-side via Admin SDK
    match /departments/{deptId} {
      allow read: if true;
      allow write: if false;
    }

    // ── Gallery Collection ──────────────────────────────────────────
    // Anyone can read gallery photos (public website)
    // Writes are handled server-side via Admin SDK
    match /gallery/{itemId} {
      allow read: if true;
      allow write: if false;
    }

    // ── Site Settings & Celebration Event ───────────────────────────
    // Anyone can read site appearance and event info (public website)
    // Writes are handled server-side via Admin SDK
    match /settings/{settingDoc} {
      allow read: if true;
      allow write: if false;
    }

    // ── RSVPs Collection ────────────────────────────────────────────
    // RSVPs are handled server-side via Admin SDK
    match /rsvps/{rsvpId} {
      allow read: if false;
      allow write: if false;
    }

    // ── Deny all other unmatched documents by default ───────────────
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
